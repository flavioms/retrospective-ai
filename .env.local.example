# Copy to .env.local for local dev (docker compose values) or set the
# equivalents in Vercel project settings for deployed environments.
# See RUNBOOK.md for full setup instructions.

# --- Database (Server Actions / Route Handlers only, never exposed to the client) ---
# Local (docker compose): matches docker-compose.yml `db` service.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Production: use your Supabase project's connection string (Settings > Database).

# --- Realtime (broadcast-only signal channel, browser-side) ---
# Local (docker compose): the `realtime` service, no Kong in front of it.
NEXT_PUBLIC_SUPABASE_REALTIME_URL=ws://localhost:4000/socket
# Production: wss://<project-ref>.supabase.co/realtime/v1

# Well-known Supabase local-dev demo anon key (safe for local Docker only —
# never use this value for a deployed environment). In production, use the
# anon key from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-supabase-demo-anon-key-or-project-anon-key>

# --- AI (OpenRouter, free-tier models) ---
OPENROUTER_API_KEY=
# Comma-separated fallback order. Verified working against a live OpenRouter key on 2026-08-05 —
# free model availability changes over time, so if generation starts failing, check
# https://openrouter.ai/models?max_price=0 for current free models and swap these out.
OPENROUTER_MODELS=nvidia/nemotron-nano-9b-v2:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-super-120b-a12b:free

# --- Cron auth (Vercel Cron sends this as a bearer token) ---
CRON_SECRET=dev-local-cron-secret
